{
  "id": "./",
  "name": "星空记账 · 极简本地记账",
  "short_name": "星空记账",
  "description": "快速记账、分类图表、预算、资产与周期记账，数据只保存在本机。",
  "lang": "zh-CN",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#f2f5f3",
  "theme_color": "#0e9f6e",
  "categories": ["finance", "productivity", "lifestyle"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "assets/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "assets/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "screenshots": [
    {
      "src": "screenshots/01-home.png",
      "sizes": "845x1828",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "账单明细与月度汇总"
    },
    {
      "src": "screenshots/03-stats.png",
      "sizes": "680x1472",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "分类占比与趋势图表"
    }
  ],
  "shortcuts": [
    {
      "name": "记一笔",
      "short_name": "记一笔",
      "description": "直接打开记账键盘",
      "url": "./?action=add",
      "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "图表",
      "short_name": "图表",
      "description": "查看本月分类与趋势",
      "url": "./?action=stats",
      "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
